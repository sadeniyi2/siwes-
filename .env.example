# Each visitor brings their OWN free Gemini key in the app (stored in their
# browser), so you do NOT need to set GEMINI_API_KEY on Vercel — leave it unset
# to keep every visitor on their own key and never spend your quota.
#
# Optionally set a shared fallback key that's used only when a visitor hasn't
# added their own (this WOULD spend your quota):
# GEMINI_API_KEY=AIza...

# Optional: pin a specific model (defaults to gemini-flash-latest, which always
# tracks the current free-tier Flash model). Other options: gemini-2.5-flash,
# gemini-2.0-flash, gemini-flash-lite-latest
# GEMINI_MODEL=gemini-flash-latest

# ── Payments (Flutterwave) — REQUIRED for the paywall ──
# Get keys from your Flutterwave dashboard → Settings → API Keys.
# Public key is safe in the browser; the secret key stays server-side.
NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK-...
FLW_SECRET_KEY=FLWSECK-...

# A long random string used to sign access tokens after a verified payment.
# Generate one with:  openssl rand -hex 32
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string

# ── Founder panel (/founder) ──
# Only these name:passcode pairs can open the founder dashboard.
FOUNDER_USERS=olive:choose-a-passcode,peace:choose-another-passcode

# ── User & trial tracking for the founder panel (optional) ──
# Free from https://upstash.com (create a Redis DB -> REST). Without these,
# sales still show in the panel, but the logged-in-users / trials list won't.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token
