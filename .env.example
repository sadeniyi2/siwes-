# Each visitor brings their OWN free Gemini key in the app (stored in their
# browser), so you do NOT need to set GEMINI_API_KEY on Vercel — leave it unset
# to keep every visitor on their own key and never spend your quota.
#
# Optionally set a shared fallback key that's used only when a visitor hasn't
# added their own (this WOULD spend your quota):
# GEMINI_API_KEY=AIza...

# Optional: pin a specific model (defaults to gemini-flash-latest, which always
# tracks the current free-tier Flash model). Other options: gemini-2.5-flash,
# gemini-2.0-flash, gemini-flash-lite-latest
# GEMINI_MODEL=gemini-flash-latest

# ── Payments (Flutterwave) — REQUIRED for the paywall ──
# Get keys from your Flutterwave dashboard → Settings → API Keys.
# Public key is safe in the browser; the secret key stays server-side.
NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK-...
FLW_SECRET_KEY=FLWSECK-...

# A long random string used to sign access tokens after a verified payment.
# Generate one with:  openssl rand -hex 32
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string

# ── Founder panel (/founder) ──
# Only these name:passcode pairs can open the founder dashboard.
FOUNDER_USERS=olive:choose-a-passcode,peace:choose-another-passcode

# ── User & trial tracking + referral codes for the founder panel (optional) ──
# Free from https://supabase.com. Create a project, then in the SQL editor run:
#   create table if not exists siwes_users (
#     id text primary key, name text, email text, firm text,
#     kind text, tier text, trial_exp bigint,
#     first_seen bigint, last_seen bigint
#   );
#   create table if not exists siwes_codes (
#     code text primary key, tier text default 'pro', note text,
#     uses bigint default 0, max_uses bigint, created bigint
#   );
#   -- if you created siwes_codes earlier, add the device-limit column:
#   alter table siwes_codes add column if not exists max_uses bigint;
#   create table if not exists siwes_code_uses (
#     id bigserial primary key, code text, name text, ip text, at bigint
#   );
#   create table if not exists siwes_trials (
#     matric text primary key, ip text, name text,
#     started bigint, exp bigint
#   );
#   create table if not exists siwes_blocks (
#     value text primary key, type text, reason text, created bigint
#   );
# Then copy Project URL + the service_role key (Settings -> API). Without these,
# sales still show in the panel, but the logged-in-users / trials list and the
# code manager won't work.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Referral / free-access codes (optional) ──
# Permanent codes that always grant free Pro, even without Supabase. Anyone who
# enters one in the "Access code" box on signup/profile gets in free. You can
# also create codes from the Founder Panel (stored in Supabase, no redeploy).
# Comma or semicolon separated.
# REFERRAL_CODES=SIWES-FRIENDS,CLASSREP-2026

# ── Free-trial abuse control (optional) ──
# The free trial requires a matric number and allows only ONE trial per matric
# (needs Supabase + the siwes_trials table above, so incognito / a new browser
# can't get another). As a soft extra guard, at most this many trials may start
# from one IP per 24h — kept lenient because campus WiFi / mobile networks share
# an IP. Set very high to effectively disable IP throttling. Default: 8.
# TRIAL_IP_LIMIT=8
